<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arms reminders after a restart; alarms don't survive one -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Keeps a running feed/sleep in step with the other phones while the app is closed (TimerSyncService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Settings → About → Updates installs this app's GitHub releases (AppUpdater); removed from F-Droid builds -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".BabyBuddyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press on a Quick Settings tile opens its screen -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tiles (widget/QuickTiles.kt) -->
        <service
            android:name=".widget.FeedTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_feed"
            android:label="@string/tile_feed_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".widget.SleepTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_sleep"
            android:label="@string/tile_sleep_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".widget.DiaperTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_diaper"
            android:label="@string/tile_diaper_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Baby Buddy Home Screen App Widgets -->
        <!-- The package installer's result for an update (update/UpdateInstallReceiver.kt) -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.BabyBuddyQuickLogWidget"
            android:exported="true"
            android:label="@string/widget_quick_log_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_log_info" />
        </receiver>

        <receiver
            android:name=".widget.BabyBuddyTimerWidget"
            android:exported="true"
            android:label="@string/widget_timer_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timer_info" />
        </receiver>

        <receiver
            android:name=".widget.BabyBuddySummaryWidget"
            android:exported="true"
            android:label="@string/widget_summary_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_summary_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.babybuddy.ACTION_TIMER_PAUSE_RESUME" />
                <action android:name="com.example.babybuddy.ACTION_TIMER_SWITCH_SIDE" />
                <action android:name="com.example.babybuddy.ACTION_QUICK_TUMMY" />
                <action android:name="com.example.babybuddy.ACTION_WIDGET_PINNED" />
                <action android:name="com.example.babybuddy.ACTION_TAP_LEFT" />
                <action android:name="com.example.babybuddy.ACTION_TAP_RIGHT" />
                <action android:name="com.example.babybuddy.ACTION_END_FEED" />
                <action android:name="com.example.babybuddy.ACTION_STOP_SLEEP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.babybuddy.ACTION_REMIND" />
            </intent-filter>
        </receiver>

        <!-- Runs only while a feed or sleep is timed: checks whether another phone ended it -->
        <service
            android:name=".widget.TimerSyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live baby feeding/sleep timer shared between caregivers' phones; follows changes made on another phone" />
        </service>

        <!-- Restores reminders (and the lock-screen timers) after a restart, an app update or a clock change -->
        <receiver
            android:name=".widget.RescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
